NODE_ENV=development
PORT=5000

# MongoDB connection string (MONGO_URI_TEST is used by __tests__/auth.test.js)
MONGO_URI=mongodb://localhost:27017/creator-dashboard
MONGO_URI_TEST=mongodb://localhost:27017/creator-dashboard-test

JWT_SECRET=change-me
JWT_EXPIRE=30d

REDIS_URL=redis://localhost:6379

# Allowed origin for Socket.io
CLIENT_URL=http://localhost:3000

# Read by utils/apiClients.js, which the feed does not call yet
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
